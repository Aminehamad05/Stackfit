# ---- Postgres (Docker, fixed named volume) ----
# Prisma needs a direct connection; pgbouncer-style pooling breaks migrations.
DATABASE_URL="postgresql://careerpath:careerpath@localhost:5433/careerpath?schema=public"
# Direct URL fallback used by `prisma migrate deploy` inside containers
DIRECT_URL="postgresql://careerpath:careerpath@postgres:5432/careerpath?schema=public"

POSTGRES_USER=careerpath
POSTGRES_PASSWORD=careerpath
POSTGRES_DB=careerpath

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- AI chat assistant (Gemini free tier) ----
# Interviewer/taster-review/question-gen stay disabled (503) — only chat is live.
# 1. Get a free key: https://aistudio.google.com → "Get API key"
# 2. Copy THESE THREE LINES into your local .env and add your key
#    (never commit .env, never paste the key in chat):
#    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#    LLM_MODEL_CHAT=gemini-3.8-flash
#    LLM_API_KEY=paste-your-key-here
# Groq alternative (also free): LLM_BASE_URL=https://api.groq.com/openai/v1
#    + LLM_MODEL_CHAT=llama-3.3-70b-versatile
AI_ENABLED=false

# ---- API / Web ----
PORT=4000
# Web → API base URL baked in at `docker build` time (Vite static replace).
# Default /api = same-origin: browser calls web:5173/api/*, nginx proxies to api:4000.
# That is what makes `docker compose up --build` work with no CORS setup.
# Only set an absolute URL to point a web build at a remote API outside compose.
VITE_API_URL=/api
