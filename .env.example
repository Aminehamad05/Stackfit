# ---- Postgres (Docker, fixed named volume) ----
# Prisma needs a direct connection; pgbouncer-style pooling breaks migrations.
DATABASE_URL="postgresql://careerpath:careerpath@localhost:5433/careerpath?schema=public"
# Direct URL fallback used by `prisma migrate deploy` inside containers
DIRECT_URL="postgresql://careerpath:careerpath@postgres:5432/careerpath?schema=public"

POSTGRES_USER=careerpath
POSTGRES_PASSWORD=careerpath
POSTGRES_DB=careerpath

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- AI / LLM layer: DISABLED for now ----
# The app is fully independent of any LLM provider. All AI features
# (interviewer, taster review, question generation, poster extraction) are
# stubbed behind AI_ENABLED and return 503 until you re-enable the layer.
# When ready, flip AI_ENABLED=true and add a provider (see apps/api/src/ai/).
AI_ENABLED=false
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_MODEL_CHAT=
# LLM_MODEL_REVIEW=
# LLM_MODEL_VISION=

# ---- API / Web ----
PORT=4000
VITE_API_URL=http://localhost:4000/api
